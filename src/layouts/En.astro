---
/**
 * 英語ページ用のレイアウト。
 * ヘッダー・フッター・CSSは日本語サイトと同じものを使い、
 * 中身だけ英語で組み直す（Elementorの日本語ページを翻訳するのは現実的でないため）。
 */
import Legacy from './Legacy.astro';
// ヘッダーはお問合せページのものを使う。背景がダイバーの写真（青）で、
// ダイビングショップらしさが出るため（店舗情報ページは夕焼けの写真だった）。
import shell from '../data/legacy/contact.json';
import pageCss from '../data/legacy/page-css.json';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** 対応する日本語ページのURL */
  jaPath: string;
  /** 見出し帯の下に出る小さな文字 */
  sub: string;
}
const { title, description, heading, jaPath, sub } = Astro.props;

/**
 * 英語ページ用の構造化データ。日本語トップ・店舗ページと同じ内容を英語で出す。
 * これがないと検索結果に営業時間や所在地が出ず、日本語ページだけが有利になる。
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsActivityLocation'],
  name: 'Diving Shop ABARO',
  alternateName: 'ダイビングショップ アバロ',
  url: new URL(Astro.url.pathname, SITE.url).href,
  telephone: '+81-54-689-7441',
  image: new URL('/wp-content/uploads/2023/06/fb4abcca0e3fb03756cb2f1199e739bc.png', SITE.url).href,
  description,
  address: {
    '@type': 'PostalAddress',
    postalCode: '424-0871',
    addressRegion: 'Shizuoka',
    addressLocality: 'Shimizu-ku, Shizuoka',
    streetAddress: '2-5-8 Uehara',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 35.008053, longitude: 138.457 },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '11:00',
      closes: '20:00',
    },
  ],
  sameAs: [SITE.instagram, SITE.facebook, SITE.x],
  availableLanguage: ['ja', 'en'],
  inLanguage: 'en',
};

/**
 * start位置から始まるタグの、対応する閉じタグの直後の位置を返す。
 * Elementorの出力は同じタグが何重にも入れ子になっているため、
 * 単純な正規表現では正しい終了位置を見つけられない。
 */
function findBlockEnd(html: string, start: number, tagName: string): number {
  const tag = new RegExp(`<${tagName}\\b|</${tagName}>`, 'g');
  tag.lastIndex = start;
  let depth = 0;
  let t: RegExpExecArray | null;
  while ((t = tag.exec(html)) !== null) {
    depth += t[0].startsWith('</') ? -1 : 1;
    if (depth === 0) return t.index + t[0].length;
  }
  return -1;
}

/** 目印の文字列を内側に含む、一番内側の <section>（または<div>）を丸ごと取り除く */
function removeBlockContaining(html: string, marker: string, tagName = 'section'): string {
  const at = html.indexOf(marker);
  if (at === -1) return html;

  const starts: number[] = [];
  const open = new RegExp(`<${tagName}\\b`, 'g');
  let m: RegExpExecArray | null;
  while ((m = open.exec(html)) !== null && m.index < at) starts.push(m.index);

  // 目印に近い順に見て、目印を内側に含むものを消す
  for (const start of starts.reverse()) {
    const end = findBlockEnd(html, start, tagName);
    if (end === -1) continue;
    if (end > at) return html.slice(0, start) + html.slice(end);
  }
  return html;
}

// 旧サイトのヘッダーには見出し帯が焼き込まれているので、そこだけ英語に差し替える。
// 日本語のメニューは、すぐ下に英語のナビがあって紛らわしいので英語ページでは出さない。
//  - アイコンメニュー（各種ライセンス／ツアー＆料金…）: セクションごと削除
//  - スマホ用のハンバーガーメニュー: 言語切り替えボタンとも重なるので削除
let headerHtml = shell.header
  .replace('>CONTACT</h2>', `>${heading.toUpperCase()}</h2>`)
  .replace(/(<span class="elementor-divider__text[^"]*">)[\s\S]*?(<\/span>)/, `$1${sub}$2`);
headerHtml = removeBlockContaining(headerHtml, 'eael-simple-menu-container');
headerHtml = removeBlockContaining(headerHtml, 'elementor-widget-nav-menu', 'div');

const NAV = [
  { href: '/en/', label: 'Home' },
  { href: '/en/courses/', label: 'Courses' },
  { href: '/en/prices/', label: 'Prices' },
  { href: '/en/access/', label: 'Access' },
  { href: '/en/faq/', label: 'FAQ' },
  { href: '/en/booking/', label: 'Booking' },
];
const here = Astro.url.pathname;

/** 旧サイトのフッターは日本語のリンク集なので、英語ページ用に組み直す */
const SOCIAL = [
  { href: 'https://www.instagram.com/diving_abaro/', icon: '/wp-content/uploads/2023/11/1.png', label: 'Instagram' },
  { href: 'https://www.facebook.com/p/100064148220401/', icon: '/wp-content/uploads/2023/11/2.png', label: 'Facebook' },
  { href: 'https://twitter.com/abaro_dive', icon: '/wp-content/uploads/2023/11/3.png', label: 'X' },
  { href: 'https://lin.ee/7XC3rEE', icon: '/wp-content/uploads/2023/11/4.png', label: 'LINE' },
];
---

<Legacy
  title={title}
  description={description}
  bodyClass="page en"
  headerHtml={headerHtml}
  cssList={pageCss.contact}
  rawTitle
  jaPath={jaPath}
  jsonLd={jsonLd}
  image="/wp-content/uploads/2023/06/fb4abcca0e3fb03756cb2f1199e739bc.png"
>
  <footer slot="footer" class="en-footer">
    <div class="en-footer__pay">
      <p>Credit cards and electronic money accepted.</p>
      <div class="en-footer__pay-logos">
        <img src="/wp-content/uploads/2023/02/pay-left-640x259-1.png" alt="Accepted credit cards" loading="lazy" />
        <img src="/wp-content/uploads/2023/02/pay-right-640x245-1.png" alt="Accepted electronic money" loading="lazy" />
      </div>
      <p class="en-footer__padi">
        Diving Shop ABARO is an officially recognised PADI dive centre in Shimizu, Shizuoka.
      </p>
    </div>

    <div class="en-footer__main">
      <div class="en-footer__cols">
        <div class="en-footer__col">
          <p class="en-footer__brand">DIVING SHOP ABARO</p>
          <p>
            2-5-8 Uehara, Shimizu-ku<br />
            Shizuoka 424-0871, Japan
          </p>
          <p>
            TEL <a href="tel:0546897441">054-689-7441</a><br />
            <span class="en-footer__muted">(+81 54-689-7441)</span>
          </p>
          <p>Open 11:00–20:00, closed Tuesdays</p>
        </div>

        <div class="en-footer__col">
          <p class="en-footer__heading">Pages</p>
          <ul>
            {NAV.map((n) => (
              <li><a href={n.href}>{n.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="en-footer__col">
          <p class="en-footer__heading">Follow us</p>
          <ul class="en-footer__social">
            {SOCIAL.map((s) => (
              <li>
                <a href={s.href} rel="noopener" target="_blank">
                  <img src={s.icon} alt="" loading="lazy" />
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="en-footer__muted">
            LINE gets the fastest reply — English is welcome.
          </p>
        </div>
      </div>

      <p class="en-footer__copy">
        © Diving Shop ABARO　|　<a href={jaPath}>日本語サイト</a>
      </p>
    </div>
  </footer>

  <div class="en-page">
    <div class="en-inner">
      <nav class="en-nav">
        {NAV.map((n) => (
          <a href={n.href} class={here === n.href ? 'is-current' : ''}>{n.label}</a>
        ))}
      </nav>
      <h1 class="en-title">{heading}</h1>
      <slot />
      <p class="en-foot">
        Questions in English are welcome. The fastest way to reach us is LINE.
        <br />
        <a href="/en/booking/">Contact us →</a>
      </p>
    </div>
  </div>
</Legacy>

<style is:global>
  .en-page { background: #fff; }
  .en-inner { max-width: 940px; margin: 0 auto; padding: 48px 20px 80px; line-height: 1.9; }
  .en-nav { display: flex; flex-wrap: wrap; gap: 4px 18px; padding-bottom: 14px; border-bottom: 1px solid #e3e6ea; margin-bottom: 40px; font-size: 14px; }
  .en-nav a { color: #4a5560; text-decoration: none; }
  .en-nav a:hover { color: #0b5c8a; }
  .en-nav a.is-current { color: #0b5c8a; font-weight: 700; }
  .en-title { font-size: 30px; letter-spacing: .04em; margin: 0 0 8px; color: #17232e; }
  .en-page h2 { font-size: 20px; margin: 52px 0 14px; padding-left: 12px; border-left: 4px solid #0b5c8a; color: #17232e; }
  .en-page h3 { font-size: 16px; margin: 28px 0 6px; color: #0b5c8a; }
  .en-page p { margin: 0 0 14px; }
  .en-page table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 12px 0 8px; }
  .en-page th, .en-page td { border: 1px solid #dfe4e9; padding: 8px 10px; text-align: left; }
  .en-page th { background: #f2f5f8; font-weight: 700; white-space: nowrap; }
  .en-page td.num { text-align: right; white-space: nowrap; }
  .en-table-wrap { overflow-x: auto; }
  .en-note { font-size: 13px; color: #6b757e; }
  .en-foot { margin-top: 64px; padding-top: 24px; border-top: 1px solid #e3e6ea; font-size: 14px; }

  /* 英語ページ専用のフッター（日本語フッターはリンク集が日本語のため使わない） */
  .en-footer__pay { background: #fff; text-align: center; padding: 40px 20px 44px; }
  .en-footer__pay p { margin: 0 0 16px; font-size: 13px; color: #4a5560; }
  .en-footer__pay-logos { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 24px; }
  .en-footer__pay-logos img { max-width: 320px; width: 100%; height: auto; }
  .en-footer__padi { margin: 22px auto 0 !important; max-width: 620px; line-height: 1.8; }

  .en-footer__main { background: #002980; color: #fff; padding: 48px 20px 28px; }
  .en-footer__cols {
    max-width: 940px; margin: 0 auto;
    display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 36px;
  }
  .en-footer__col p { margin: 0 0 14px; font-size: 14px; line-height: 1.8; }
  .en-footer__brand { font-weight: 700; letter-spacing: .06em; font-size: 16px !important; }
  .en-footer__heading {
    font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    font-size: 12px !important; color: #9db4e8; margin-bottom: 12px !important;
  }
  .en-footer__muted { color: #a9bce4; font-size: 13px !important; }
  .en-footer__col ul { list-style: none; margin: 0; padding: 0; }
  .en-footer__col li { margin-bottom: 9px; font-size: 14px; }
  .en-footer a { color: #fff; text-decoration: none; }
  .en-footer__main a:hover { text-decoration: underline; }
  .en-footer__social a { display: inline-flex; align-items: center; gap: 8px; }
  .en-footer__social img { width: 22px; height: 22px; object-fit: contain; }
  .en-footer__copy {
    max-width: 940px; margin: 40px auto 0; padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, .22);
    font-size: 12px; color: #b9c9ec;
  }
  .en-footer__copy a { color: #b9c9ec; text-decoration: underline; }
  @media (max-width: 767px) {
    .en-footer__cols { grid-template-columns: 1fr; gap: 30px; }
    .en-footer__main { padding: 36px 20px 24px; }
  }
  @media (max-width: 640px) {
    .en-inner { padding: 32px 16px 60px; }
    .en-title { font-size: 24px; }
  }
</style>

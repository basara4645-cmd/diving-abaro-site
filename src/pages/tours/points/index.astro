---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/PostCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { AREA_CATEGORIES } from '../../../lib/site';
import { DAY_TOURS } from '../../../data/tours';
import { loadAll } from '../../../lib/posts';
const { posts } = await loadAll();
const byArea = AREA_CATEGORIES.map((a) => ({ ...a, posts: posts.filter((p) => p.category?.slug === a.slug).slice(0, 4) }));
const pointNames = [...new Set(DAY_TOURS.map((t) => t.point))];
---
<Base title="ダイビングポイント一覧" description="アバロが開催する伊豆半島・千葉・神奈川のダイビングポイント紹介。西伊豆・東伊豆・南伊豆・千葉・その他エリア。" image="/wp-content/uploads/2023/02/d12c9916ab1317f039edc046caa416d1-1024x462.png">
  <PageHero en="Diving Point" ja="ダイビングポイント一覧" crumbs={[{ href: '/tours/', label: 'ツアー＆料金' }]} image="/wp-content/uploads/2023/11/e3c90e9831b2cd22dcee07d6c8a56fbd.jpg" lead="伊豆半島30か所以上、すべてのポイントで開催可能。エリアごとのポイント紹介記事をご覧ください。" />
  <section class="section bg-paper">
    <div class="wrap">
      <div class="tags reveal">{pointNames.map((n) => <span>{n}</span>)}</div>
      {byArea.map((a) => (
        <div class="area-block">
          <div class="ab-head reveal">
            <h2 class="display">{a.slug.replace('-area', '').replace('-areas', '').toUpperCase()}</h2>
            <p class="title-ja">{a.name}</p>
            <a href={`/category/${a.slug}/`} class="btn btn-ghost btn-sm">記事一覧</a>
          </div>
          {a.posts.length ? <div class="grid g4">{a.posts.map((p, i) => <PostCard post={p} delay={i} />)}</div> : <p class="muted">coming soon...</p>}
        </div>
      ))}
    </div>
  </section>
  <CtaBand title="行きたいポイントをリクエスト" />
</Base>
<style>
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 3rem; }
  .tags span { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.3em 0.9em; font-size: 0.82rem; font-weight: 700; color: var(--navy); }
  .area-block { margin-bottom: 3.5rem; }
  .ab-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .ab-head .display { font-size: 2.4rem; color: var(--navy); }
  .ab-head .btn { margin-left: auto; }
  .muted { color: var(--ink-2); }
</style>

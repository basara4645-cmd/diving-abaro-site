---
import { NAV, SITE } from '../lib/site';
const { transparent = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['site-header', { transparent }]} id="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={SITE.name}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 24c4-4 8-4 12 0s8 4 12 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M8 17c4-4 8-4 12 0s8 4 12 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity=".55"/><circle cx="27" cy="10" r="2" fill="currentColor"/></svg>
      </span>
      <span class="brand-text">
        <span class="brand-en">DIVING SHOP ABARO</span>
        <span class="brand-ja">静岡・清水のダイビングショップ</span>
      </span>
    </a>
    <nav class="nav" aria-label="メイン">
      <ul>
        {NAV.filter((n) => n.href !== '/contact/').map((n) => (
          <li><a href={n.href} class:list={{ active: isActive(n.href) }}><span class="en">{n.label}</span><span class="ja">{n.ja}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a href={SITE.line} class="btn btn-line btn-sm no-arrow" target="_blank" rel="noopener">LINEで相談</a>
      <a href="/contact/" class="btn btn-sun btn-sm no-arrow">お問い合わせ</a>
      <button class="burger" id="burger" aria-expanded="false" aria-controls="drawer" aria-label="メニュー"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="drawer" id="drawer">
    <ul>
      {NAV.map((n) => (
        <li><a href={n.href}><span class="en">{n.label}</span><span class="ja">{n.ja}</span></a></li>
      ))}
    </ul>
    <div class="drawer-cta">
      <a href={SITE.telHref} class="btn btn-ghost no-arrow">📞 {SITE.tel}</a>
      <a href={SITE.line} class="btn btn-line no-arrow" target="_blank" rel="noopener">LINEで相談</a>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,253,249,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(10,26,51,0.08); transition: background 0.4s, color 0.4s; color: var(--navy); }
  .site-header.transparent { position: fixed; left: 0; right: 0; background: transparent; border-color: transparent; color: #fff; }
  .site-header.transparent.scrolled { background: rgba(10,26,51,0.85); border-color: rgba(255,255,255,0.08); }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 74px; }
  .brand { display: flex; align-items: center; gap: 0.7rem; color: inherit; text-decoration: none !important; }
  .brand-mark { display: grid; place-items: center; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-en { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: 0.06em; }
  .brand-ja { font-size: 0.68rem; letter-spacing: 0.12em; opacity: 0.75; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 0.2rem; list-style: none; margin: 0; padding: 0; }
  .nav a { display: flex; flex-direction: column; align-items: center; padding: 0.4rem 0.9rem; color: inherit; text-decoration: none !important; border-radius: 8px; position: relative; }
  .nav .en { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: 0.1em; }
  .nav .ja { font-size: 0.66rem; opacity: 0.7; letter-spacing: 0.06em; }
  .nav a::after { content: ''; position: absolute; left: 0.9rem; right: 0.9rem; bottom: 0.15rem; height: 2px; background: var(--sun); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease); }
  .nav a:hover::after, .nav a.active::after { transform: scaleX(1); }
  .actions { display: flex; align-items: center; gap: 0.5rem; }
  .burger { display: none; width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; color: inherit; }
  .burger span { width: 24px; height: 2px; background: currentColor; transition: transform 0.3s, opacity 0.3s; }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .drawer { display: none; background: var(--navy); color: #fff; padding: 1rem 1.25rem 2rem; }
  .drawer ul { list-style: none; margin: 0; padding: 0; }
  .drawer li a { display: flex; align-items: baseline; gap: 0.8rem; padding: 0.9rem 0.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); color: #fff; text-decoration: none !important; }
  .drawer .en { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; letter-spacing: 0.08em; }
  .drawer .ja { font-size: 0.8rem; opacity: 0.7; }
  .drawer-cta { display: grid; gap: 0.6rem; margin-top: 1.2rem; }
  .site-header.open .drawer { display: block; }
  @media (max-width: 1024px) {
    .nav { display: none; }
    .burger { display: flex; }
    .actions .btn-sun { display: none; }
  }
  @media (max-width: 560px) { .actions .btn-line { display: none; } .brand-ja { display: none; } }
</style>
<script>
  const header = document.getElementById('site-header')!;
  const burger = document.getElementById('burger')!;
  burger.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

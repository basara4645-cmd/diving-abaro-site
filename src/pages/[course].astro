---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import CtaBand from '../components/CtaBand.astro';
import { COURSES, type Course } from '../data/courses';
import { SITE } from '../lib/site';

export function getStaticPaths() {
  return COURSES.map((c) => ({ params: { course: c.slug }, props: { course: c } }));
}
const { course } = Astro.props as { course: Course };
const isExp = course.slug === 'experience';
const crumbs = isExp ? [] : [{ href: '/license/', label: '各種ライセンスコース' }];
const others = COURSES.filter((c) => c.slug !== course.slug);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.ja,
  description: course.short,
  provider: { '@type': 'Organization', name: SITE.name, sameAs: SITE.url },
  offers: { '@type': 'Offer', price: course.price.replace(/,/g, ''), priceCurrency: 'JPY' },
};
---
<Base title={course.ja} description={course.short} image={course.image} jsonLd={jsonLd}>
  <PageHero en={course.en} ja={course.ja} image={course.image} crumbs={crumbs} />

  <section class="section intro bg-paper">
    <div class="wrap grid-intro">
      <div class="reveal">
        <p class="eyebrow">ABOUT</p>
        <p class="lead-big">{course.lead}</p>
        {course.perks && isExp && <ul class="check-list mt-2">{course.perks.map((p) => <li>{p}</li>)}</ul>}
      </div>
      <aside class="facts reveal" data-delay="1">
        <div class="fact price">
          <span class="k">料金</span>
          <span class="v"><small>¥</small>{course.price}<small>（税込）</small></span>
        </div>
        <div class="fact">
          <span class="k">講習日数</span>
          <span class="v">{course.days}{course.daysNote && <small>（{course.daysNote}）</small>}</span>
        </div>
        <div class="fact">
          <span class="k">参加前条件</span>
          <span class="v cond">{course.condition}</span>
          {course.conditionNotes && <ul class="cond-notes">{course.conditionNotes.map((n) => <li>{n}</li>)}</ul>}
        </div>
        {course.place && <div class="fact"><span class="k">開催場所</span><span class="v cond">{course.place}</span></div>}
        <div class="inc">
          <div><strong>料金に含まれるもの</strong><ul>{course.included.map((i) => <li>{i}</li>)}</ul></div>
          <div><strong>含まれないもの</strong><ul>{course.excluded.map((i) => <li>{i}</li>)}</ul></div>
        </div>
        <div class="fact-cta">
          {course.cta ? <a href={course.cta.href} class="btn btn-sun" target="_blank" rel="noopener">{course.cta.label}</a> : <a href="/contact/" class="btn btn-sun">このコースを申し込む・相談する</a>}
          <a href={SITE.line} class="btn btn-line" target="_blank" rel="noopener">LINEで相談</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section flow">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="display">Course Schedule</h2>
        <p class="title-ja">{course.ja}の流れ</p>
        {course.flow && <p class="lead">{course.flow}</p>}
      </div>
      <div class="days">
        {course.days_detail.map((d) => (
          <div class="day">
            <div class="day-head reveal">
              <span class="eyebrow">{d.heading}</span>
              <h3>{d.ja}</h3>
              {d.note && <p class="note">{d.note}</p>}
            </div>
            <div class:list={['day-body', { hasimg: !!d.image }]}>
              {d.image && <div class="day-img reveal"><img src={d.image} alt="" loading="lazy" width="640" height="480" /></div>}
              <Timeline steps={d.steps} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {course.certification && (
    <section class="section cert bg-navy grain">
      <div class="wrap center reveal">
        <p class="eyebrow">CERTIFICATION</p>
        <h2 class="cert-title">{course.certification.title}</h2>
        {course.certification.body && <p class="lead" style="margin-inline:auto">{course.certification.body}</p>}
        {course.perks && (
          <div class="perk">
            <span class="perk-label">アバロで{course.ja.replace('PADI ', '')}を修了された方の特典</span>
            <ul>{course.perks.map((p) => <li>{p}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section-tight others bg-paper">
    <div class="wrap">
      <p class="eyebrow">OTHER COURSES</p>
      <div class="other-grid">
        {others.map((o) => <a href={`/${o.slug}/`} class="other"><span class="o-en">{o.en}</span><span class="o-ja">{o.ja}</span><span class="o-price">¥{o.price}</span></a>)}
      </div>
    </div>
  </section>

  <CtaBand booking={isExp} title={isExp ? '体験ダイビングのご予約はこちら' : `${course.ja}のお申し込み・ご相談`} />
</Base>

<style>
  .grid-intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .lead-big { font-size: 1.08rem; line-height: 2; margin-top: 0.5rem; }
  .facts { background: #fff; border-radius: var(--r); box-shadow: var(--shadow); padding: 1.6rem 1.8rem; display: grid; gap: 1rem; position: sticky; top: 90px; }
  .fact { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.5rem 1rem; align-items: center; padding-bottom: 1rem; border-bottom: 1px dashed var(--line); }
  .fact .k { background: var(--navy); color: #fff; font-size: 0.8rem; font-weight: 700; border-radius: 999px; padding: 0.4em 0; text-align: center; letter-spacing: 0.1em; }
  .fact .v { font-family: var(--font-display); font-weight: 800; font-size: 2rem; color: var(--price); line-height: 1; }
  .fact .v small { font-family: var(--font-body); font-size: 0.8rem; font-weight: 500; color: var(--ink-2); margin: 0 0.2em; }
  .fact .v.cond { font-family: var(--font-body); font-size: 1.05rem; color: var(--ink); font-weight: 700; line-height: 1.5; }
  .cond-notes { grid-column: 2; margin: 0; padding-left: 1.1em; font-size: 0.82rem; color: var(--ink-2); }
  .inc { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.85rem; }
  .inc strong { display: block; color: var(--navy); margin-bottom: 0.3rem; }
  .inc ul { padding-left: 1.1em; color: var(--ink-2); margin: 0; }
  .fact-cta { display: grid; gap: 0.6rem; margin-top: 0.4rem; }
  .fact-cta .btn { justify-content: center; }
  @media (max-width: 860px) { .grid-intro { grid-template-columns: 1fr; } .facts { position: static; } }

  .days { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .day-head h3 { font-size: 1.5rem; margin-top: 0.2rem; }
  .day-head .note { font-size: 0.85rem; color: var(--ink-2); margin: 0.4rem 0 0; }
  .day-body { margin-top: 1.5rem; }
  .day-body.hasimg { display: grid; grid-template-columns: 1fr 1.6fr; gap: 2.5rem; align-items: start; }
  .day-img { border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 4/3; }
  .day-img img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 800px) { .day-body.hasimg { grid-template-columns: 1fr; } }

  .cert-title { font-size: clamp(1.6rem, 4vw, 2.6rem); color: #fff; margin: 0.4rem 0 1rem; }
  .perk { display: inline-block; margin-top: 1.5rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,183,3,0.5); border-radius: var(--r); padding: 1.2rem 2rem; text-align: left; }
  .perk-label { display: inline-block; background: var(--sun); color: var(--navy); font-weight: 700; font-size: 0.8rem; padding: 0.2em 0.9em; border-radius: 999px; margin-bottom: 0.6rem; }
  .perk ul { list-style: none; padding: 0; margin: 0; font-size: 1.15rem; font-weight: 700; color: #fff; }
  .perk li::before { content: '🎁 '; }

  .other-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.8rem; margin-top: 0.8rem; }
  .other { display: grid; gap: 0.2rem; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 0.9rem 1rem; color: var(--ink); text-decoration: none !important; transition: border-color 0.3s, transform 0.3s; }
  .other:hover { border-color: var(--navy); transform: translateY(-2px); }
  .o-en { font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.08em; color: var(--ocean); }
  .o-ja { font-size: 0.82rem; font-weight: 700; }
  .o-price { font-family: var(--font-display); font-weight: 700; color: var(--price); }
  @media (max-width: 900px) { .other-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

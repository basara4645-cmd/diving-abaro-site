---
import Base from '../layouts/Base.astro';
---
<Base title="ページが見つかりません">
  <section class="section bg-paper center" style="min-height:60vh;display:grid;place-items:center">
    <div>
      <p class="display" style="font-size:6rem;color:var(--navy)">404</p>
      <p class="lead" style="margin-inline:auto">お探しのページは移動したか、削除された可能性があります。</p>
      <a href="/" class="btn mt-2">トップページへ</a>
    </div>
  </section>
</Base>

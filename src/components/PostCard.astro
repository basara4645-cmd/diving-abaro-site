---
import type { Post } from '../lib/posts';
import { fmtDate } from '../lib/posts';
const { post, delay = 0, large = false } = Astro.props as { post: Post; delay?: number; large?: boolean };
---
<a href={post.path} class:list={['card reveal', { large }]} data-delay={delay}>
  <div class="thumb">
    {post.eyecatch ? <img src={post.eyecatch} alt="" loading="lazy" width="800" height="600" /> : <div class="ph"></div>}
    {post.category && <span class="cat">{post.category.name}</span>}
  </div>
  <div class="body">
    <time datetime={post.date}>{fmtDate(post.date)}</time>
    <h3>{post.title}</h3>
    {large && <p>{post.excerpt}</p>}
  </div>
</a>
<style>
  .card { display: flex; flex-direction: column; background: #fff; border-radius: var(--r); overflow: hidden; color: var(--ink); text-decoration: none !important; box-shadow: 0 10px 30px -18px rgba(10,26,51,0.35); transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease); }
  .card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .thumb { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--navy-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .card:hover .thumb img { transform: scale(1.06); }
  .ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--navy-2), var(--ocean-2)); }
  .cat { position: absolute; left: 0.8rem; top: 0.8rem; background: var(--sun); color: var(--navy); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; padding: 0.25em 0.7em; border-radius: 999px; }
  .body { padding: 1rem 1.1rem 1.2rem; display: grid; gap: 0.3rem; }
  time { font-family: var(--font-display); font-weight: 700; letter-spacing: 0.1em; color: var(--ocean); font-size: 0.95rem; }
  h3 { font-size: 1rem; line-height: 1.55; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  p { font-size: 0.85rem; color: var(--ink-2); margin: 0.3rem 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

---
/**
 * トップページ。旧サイトのHTMLをそのまま使い、記事一覧の部分だけ
 * microCMSの最新データで差し替える。
 */
import Legacy from '../layouts/Legacy.astro';
import home from '../data/legacy/home.json';
import pageCss from '../data/legacy/page-css.json';
import newsTpl from '../data/legacy/tpl-news-item.html?raw';
import gridTpl from '../data/legacy/tpl-grid-item.html?raw';
import { loadAll, thumbUrl, type Post } from '../lib/posts';
import { SITE } from '../lib/site';

const { posts } = await loadAll();
const latest = posts.slice(0, 4);

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

/** 「9月 5, 2026」形式（旧サイトの表記に合わせる） */
const wpDate = (iso: string) => {
  const d = new Date(iso);
  return `${d.getMonth() + 1}月 ${d.getDate()}, ${d.getFullYear()}`;
};

const FALLBACK = '/wp-content/uploads/2023/02/main03.png';

const fill = (tpl: string, p: Post, i: number, useThumb = false) =>
  tpl
    .replaceAll('{{ID}}', String(i + 1))
    .replaceAll('{{IMGID}}', String(i + 1))
    .replaceAll('{{THUMB}}', useThumb ? thumbUrl(p.eyecatch, FALLBACK) : (p.eyecatch ?? FALLBACK))
    .replaceAll('{{URL}}', p.path)
    .replaceAll('{{DATE}}', wpDate(p.date))
    .replaceAll('{{TITLE}}', esc(p.title))
    .replaceAll('{{EXCERPT}}', esc(p.excerpt));

const newsHtml = latest.map((p, i) => fill(newsTpl, p, i)).join('\n');
const gridHtml = latest.map((p, i) => fill(gridTpl, p, i, true)).join('\n');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsActivityLocation'],
  name: SITE.name,
  alternateName: SITE.nameEn,
  url: SITE.url,
  telephone: '+81-54-689-7441',
  image: new URL('/wp-content/uploads/2023/02/main02.png', SITE.url).href,
  address: {
    '@type': 'PostalAddress',
    postalCode: '424-0871',
    addressRegion: '静岡県',
    addressLocality: '静岡市清水区',
    streetAddress: '上原2-5-8',
    addressCountry: 'JP',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 35.008053, longitude: 138.457 },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '11:00',
      closes: '20:00',
    },
  ],
  sameAs: [SITE.instagram, SITE.facebook, SITE.x],
};
---

<Legacy
  description={SITE.description}
  jsonLd={jsonLd}
  headerHtml={home.header}
  footerHtml={home.footer}
  cssList={pageCss.home}
>
  <Fragment set:html={home.homeParts.before_news} />
  <Fragment set:html={newsHtml} />
  <Fragment set:html={home.homeParts.between} />
  <Fragment set:html={gridHtml} />
  <Fragment set:html={home.homeParts.after_grid} />
</Legacy>

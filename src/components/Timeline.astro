---
const { steps } = Astro.props;
---
<ol class="tl">
  {steps.map((s: any, i: number) => (
    <li class="reveal" data-delay={Math.min(i, 3)}>
      <span class="time">{s.time}</span>
      <div><strong>{s.title}</strong>{s.body && <p>{s.body}</p>}</div>
    </li>
  ))}
</ol>
<style>
  .tl { list-style: none; padding: 0; margin: 0; position: relative; display: grid; gap: 0; }
  .tl::before { content: ''; position: absolute; left: 7.4rem; top: 0.9rem; bottom: 0.9rem; width: 2px; background: linear-gradient(var(--ocean-2), var(--aqua)); border-radius: 2px; }
  .tl li { display: grid; grid-template-columns: 6.3rem 1fr; gap: 2.2rem; padding: 0.9rem 0; position: relative; }
  .tl li::before { content: ''; position: absolute; left: calc(7.4rem - 6px); top: 1.55rem; width: 14px; height: 14px; border-radius: 50%; background: var(--sun); border: 3px solid var(--paper); box-shadow: 0 0 0 2px var(--ocean-2); }
  .time { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--ocean); letter-spacing: 0.04em; text-align: right; line-height: 1.6; padding-top: 0.15rem; }
  strong { font-size: 1.05rem; }
  p { margin: 0.25rem 0 0; font-size: 0.92rem; color: var(--ink-2); }
  @media (max-width: 640px) {
    .tl::before { left: 0.5rem; }
    .tl li { grid-template-columns: 1fr; gap: 0.2rem; padding-left: 2rem; }
    .tl li::before { left: calc(0.5rem - 6px); top: 1.2rem; }
    .time { text-align: left; }
  }
</style>

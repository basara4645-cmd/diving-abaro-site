---
/**
 * 英語ページ用のレイアウト。
 * ヘッダー・フッター・CSSは日本語サイトと同じものを使い、
 * 中身だけ英語で組み直す（Elementorの日本語ページを翻訳するのは現実的でないため）。
 */
import Legacy from './Legacy.astro';
import shell from '../data/legacy/store.json';
import pageCss from '../data/legacy/page-css.json';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** 対応する日本語ページのURL */
  jaPath: string;
  /** 見出し帯の下に出る小さな文字 */
  sub: string;
}
const { title, description, heading, jaPath, sub } = Astro.props;

// 旧サイトのヘッダーには見出し帯が焼き込まれているので、そこだけ英語に差し替える
const headerHtml = shell.header
  .replace('>STORE</h2>', `>${heading.toUpperCase()}</h2>`)
  .replace(/(<span class="elementor-divider__text[^"]*">)[\s\S]*?(<\/span>)/, `$1${sub}$2`)
  .replace(/<li class="menu-item[^"]*current[^"]*"/g, '<li class="menu-item"')
  .replace(/ class="elementor-item elementor-item-active"/g, ' class="elementor-item"');

const NAV = [
  { href: '/en/', label: 'Home' },
  { href: '/en/courses/', label: 'Courses' },
  { href: '/en/prices/', label: 'Prices' },
  { href: '/en/access/', label: 'Access' },
  { href: '/en/booking/', label: 'Booking' },
];
const here = Astro.url.pathname;
---

<Legacy
  title={title}
  description={description}
  bodyClass="page en"
  headerHtml={headerHtml}
  footerHtml={shell.footer}
  cssList={pageCss.store}
  rawTitle
  jaPath={jaPath}
>
  <div class="en-page">
    <div class="en-inner">
      <nav class="en-nav">
        {NAV.map((n) => (
          <a href={n.href} class={here === n.href ? 'is-current' : ''}>{n.label}</a>
        ))}
      </nav>
      <h1 class="en-title">{heading}</h1>
      <slot />
      <p class="en-foot">
        Questions in English are welcome. The fastest way to reach us is LINE.
        <br />
        <a href="/en/booking/">Contact us →</a>
      </p>
    </div>
  </div>
</Legacy>

<style is:global>
  .en-page { background: #fff; }
  .en-inner { max-width: 940px; margin: 0 auto; padding: 48px 20px 80px; line-height: 1.9; }
  .en-nav { display: flex; flex-wrap: wrap; gap: 4px 18px; padding-bottom: 14px; border-bottom: 1px solid #e3e6ea; margin-bottom: 40px; font-size: 14px; }
  .en-nav a { color: #4a5560; text-decoration: none; }
  .en-nav a:hover { color: #0b5c8a; }
  .en-nav a.is-current { color: #0b5c8a; font-weight: 700; }
  .en-title { font-size: 30px; letter-spacing: .04em; margin: 0 0 8px; color: #17232e; }
  .en-page h2 { font-size: 20px; margin: 52px 0 14px; padding-left: 12px; border-left: 4px solid #0b5c8a; color: #17232e; }
  .en-page h3 { font-size: 16px; margin: 28px 0 6px; color: #0b5c8a; }
  .en-page p { margin: 0 0 14px; }
  .en-page table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 12px 0 8px; }
  .en-page th, .en-page td { border: 1px solid #dfe4e9; padding: 8px 10px; text-align: left; }
  .en-page th { background: #f2f5f8; font-weight: 700; white-space: nowrap; }
  .en-page td.num { text-align: right; white-space: nowrap; }
  .en-table-wrap { overflow-x: auto; }
  .en-note { font-size: 13px; color: #6b757e; }
  .en-foot { margin-top: 64px; padding-top: 24px; border-top: 1px solid #e3e6ea; font-size: 14px; }
  @media (max-width: 640px) {
    .en-inner { padding: 32px 16px 60px; }
    .en-title { font-size: 24px; }
  }
</style>

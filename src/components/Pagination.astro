---
const { current, total, base } = Astro.props as { current: number; total: number; base: string };
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const pages = Array.from({ length: total }, (_, i) => i + 1).filter((n) => n === 1 || n === total || Math.abs(n - current) <= 2);
---
{total > 1 && (
  <nav class="pg" aria-label="ページ送り">
    {current > 1 && <a href={href(current - 1)} class="arrow">←</a>}
    {pages.map((n, i) => (
      <>
        {i > 0 && pages[i - 1] !== n - 1 && <span class="gap">…</span>}
        <a href={href(n)} class:list={{ on: n === current }} aria-current={n === current ? 'page' : undefined}>{n}</a>
      </>
    ))}
    {current < total && <a href={href(current + 1)} class="arrow">→</a>}
  </nav>
)}
<style>
  .pg { display: flex; justify-content: center; gap: 0.4rem; flex-wrap: wrap; margin-top: 3rem; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .pg a { min-width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border-radius: 999px; background: #fff; color: var(--navy); border: 1px solid var(--line); text-decoration: none !important; }
  .pg a.on { background: var(--navy); color: #fff; border-color: var(--navy); }
  .pg a:hover:not(.on) { border-color: var(--navy); }
  .gap { align-self: center; color: var(--ink-2); }
</style>

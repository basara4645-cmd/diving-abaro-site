---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { loadAll, fmtDate } from '../lib/posts';
import { SITE } from '../lib/site';
export async function getStaticPaths() {
  const { posts } = await loadAll();
  return posts.map((p, i) => ({
    params: { path: p.path.replace(/^\/|\/$/g, '') },
    props: { post: p, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null, related: posts.filter((q) => q.id !== p.id && q.category?.slug === p.category?.slug).slice(0, 3) },
  }));
}
const { post, prev, next, related } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date,
  image: post.eyecatch ? new URL(post.eyecatch, SITE.url).href : undefined,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(post.path, SITE.url).href,
};
---
<Base title={post.title} description={post.excerpt} image={post.eyecatch ?? undefined} type="article" jsonLd={jsonLd}>
  <article class="post">
    <header class="post-head">
      <div class="wrap-narrow">
        <Breadcrumb items={[{ href: '/blog/', label: 'ブログ＆新着情報' }, ...(post.category ? [{ href: `/category/${post.category.slug}/`, label: post.category.name }] : []), { label: post.title }]} />
        <div class="meta">
          <time datetime={post.date}>{fmtDate(post.date)}</time>
          {post.category && <a href={`/category/${post.category.slug}/`} class="cat">{post.category.name}</a>}
        </div>
        <h1>{post.title}</h1>
      </div>
    </header>
    {post.eyecatch && <div class="wrap-narrow"><img src={post.eyecatch} alt="" class="eyecatch" width="1024" height="768" fetchpriority="high" /></div>}
    <div class="wrap-narrow">
      <div class="prose" set:html={post.content} />
      <div class="share">
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(new URL(post.path, SITE.url).href)}`} target="_blank" rel="noopener">Xでシェア</a>
        <a href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(new URL(post.path, SITE.url).href)}`} target="_blank" rel="noopener">LINEで送る</a>
      </div>
      <nav class="pn">
        {prev ? <a href={prev.path} class="p"><span>← 前の記事</span><strong>{prev.title}</strong></a> : <span></span>}
        {next ? <a href={next.path} class="n"><span>次の記事 →</span><strong>{next.title}</strong></a> : <span></span>}
      </nav>
    </div>
    {related.length > 0 && (
      <section class="section-tight related bg-paper">
        <div class="wrap">
          <p class="eyebrow">RELATED</p>
          <div class="grid g3">{related.map((p, i) => <PostCard post={p} delay={i} />)}</div>
          <p class="center mt-3"><a href="/blog/" class="btn btn-ghost">記事一覧へ戻る</a></p>
        </div>
      </section>
    )}
  </article>
  <CtaBand booking title="一緒に潜りませんか？" body="ブログの海に行ってみたい方、はじめての方も大歓迎。LINEでお気軽にどうぞ。" />
</Base>
<style>
  .post-head { padding: 3rem 0 2rem; }
  .meta { display: flex; align-items: center; gap: 1rem; margin: 1.2rem 0 0.6rem; }
  time { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: 0.1em; color: var(--ocean); }
  .cat { background: var(--sun); color: var(--navy); font-size: 0.75rem; font-weight: 700; padding: 0.2em 0.8em; border-radius: 999px; text-decoration: none !important; }
  h1 { font-size: clamp(1.5rem, 3.4vw, 2.3rem); line-height: 1.4; }
  .eyecatch { border-radius: var(--r); box-shadow: var(--shadow); width: 100%; aspect-ratio: 4/3; object-fit: cover; margin-bottom: 2rem; }
  .share { display: flex; gap: 0.6rem; margin: 3rem 0 1.5rem; }
  .share a { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 0.4em 1.1em; font-size: 0.85rem; font-weight: 700; color: var(--navy); text-decoration: none !important; }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 1.5rem 0 3rem; border-top: 1px solid var(--line); }
  .pn a { display: grid; gap: 0.2rem; color: var(--ink); text-decoration: none !important; font-size: 0.9rem; }
  .pn a span { font-size: 0.75rem; color: var(--ocean); font-weight: 700; }
  .pn .n { text-align: right; }
  @media (max-width: 600px) { .pn { grid-template-columns: 1fr; } .pn .n { text-align: left; } }
</style>

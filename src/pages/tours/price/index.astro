---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { DAY_TOURS, OPTION_DIVES, TOUR_RULES, NO_DISCOUNT_AREAS } from '../../../data/tours';
const areas = [...new Set(DAY_TOURS.map((t) => t.area))];
---
<Base title="日帰りツアー料金" description="伊豆・三保・千葉・神奈川の日帰りダイビングツアー料金表。ガイド料・施設使用料・タンク代・保険・ランチ代まで含んだコミコミ価格。" image="/wp-content/uploads/2023/06/39b7083e5d42f9b622a28379ddcb855b.png">
  <PageHero en="One Day Tour" ja="日帰りツアー料金" crumbs={[{ href: '/tours/', label: 'ツアー＆料金' }]} image="/wp-content/uploads/2023/11/dc7b18bdd0118fd79c5811c52f96c516.jpg" lead="表示は税込価格（OW〜RED）。MSD（マスタースクーバダイバー）は −¥1,000、DM（ダイブマスター）以上は −¥3,300 でご参加いただけます。" />
  <section class="section bg-paper">
    <div class="wrap">
      <div class="legend reveal">
        <span class="chip">OW〜RED：表示価格</span><span class="chip">MSD：−¥1,000</span><span class="chip">DM〜：−¥3,300</span><span class="chip muted">千葉・神奈川は割引対象外</span>
      </div>
      <div class="filters reveal" role="tablist" aria-label="エリア絞り込み">
        <button class="f on" data-area="all">すべて</button>
        {areas.map((a) => <button class="f" data-area={a}>{a}</button>)}
      </div>
      <div class="table-wrap reveal">
        <table class="tbl" id="tour-table">
          <thead><tr><th>エリア</th><th>ポイント</th><th>スタイル</th><th>税込価格（OW〜RED）</th><th>MSD</th><th>DM〜</th></tr></thead>
          <tbody>
            {DAY_TOURS.map((t) => {
              const base = parseInt(t.price.replace(/,/g, ''));
              const nd = NO_DISCOUNT_AREAS.includes(t.area);
              const f = (n: number) => n.toLocaleString('ja-JP');
              return (
                <tr data-area={t.area}>
                  <td class="area">{t.area}</td>
                  <td><strong>{t.point}</strong></td>
                  <td class="muted">{t.style}</td>
                  <td class="num">¥{t.price}</td>
                  <td class="muted">{nd ? '—' : `¥${f(base - 1000)}`}</td>
                  <td class="muted">{nd ? '—' : `¥${f(base - 3300)}`}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <h2 class="sub">オプションダイブ</h2>
      <div class="table-wrap reveal" style="max-width:520px">
        <table class="tbl" style="min-width:0">
          <thead><tr><th>スタイル</th><th>税込価格</th></tr></thead>
          <tbody>{OPTION_DIVES.map((o) => <tr><td><strong>{o.style}</strong></td><td class="num">¥{o.price}</td></tr>)}</tbody>
        </table>
      </div>
      <h2 class="sub">ツアールール</h2>
      <ul class="note-list rules reveal">{TOUR_RULES.map((r) => <li>{r}</li>)}</ul>
      <p class="mt-2"><a href="/tours/rental/" class="btn btn-ghost">レンタル器材料金を見る</a></p>
    </div>
  </section>
  <CtaBand title="ツアーのご予約・リクエスト" />
</Base>
<style>
  .legend { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .chip { background: var(--navy); color: #fff; font-size: 0.78rem; font-weight: 700; padding: 0.3em 0.9em; border-radius: 999px; }
  .chip.muted { background: var(--sand-2); color: var(--ink-2); }
  .filters { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .f { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 0.45em 1.1em; cursor: pointer; font-weight: 700; font-size: 0.85rem; color: var(--ink-2); }
  .f.on { background: var(--sun); color: var(--navy); border-color: var(--sun); }
  .sub { font-size: 1.3rem; margin: 3rem 0 1rem; color: var(--navy); padding-left: 0.8rem; border-left: 5px solid var(--sun); }
  .rules { background: #fff; border-radius: var(--r); padding: 1.5rem 1.8rem; border: 1px solid var(--line); }
</style>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.f');
  const rows = document.querySelectorAll<HTMLTableRowElement>('#tour-table tbody tr');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    const a = b.dataset.area;
    rows.forEach((r) => { r.hidden = !(a === 'all' || r.dataset.area === a); });
  }));
</script>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { TOUR_FEATURES, TOUR_GALLERY, DAY_TOURS } from '../../data/tours';
import { SITE, AREA_CATEGORIES } from '../../lib/site';
import { loadAll } from '../../lib/posts';
const { posts } = await loadAll();
const expedition = posts.filter((p) => /遠征|お泊|泊まり|沖縄|海外/.test(p.title)).slice(0, 3);
const cheapest = DAY_TOURS.reduce((a, b) => (parseInt(a.price.replace(/,/g, '')) < parseInt(b.price.replace(/,/g, '')) ? a : b));
---
<Base title="ツアースケジュール＆料金" description="伊豆半島30か所以上のダイビングポイントすべてで日帰りツアーを開催。沖縄・海外・千葉などの遠征ツアーも。お一人様歓迎、清水・沼津・三島から無料送迎。" image="/wp-content/uploads/2023/06/39b7083e5d42f9b622a28379ddcb855b.png">
  <PageHero en="Tour" ja="ツアースケジュール＆料金" image="/wp-content/uploads/2023/06/39b7083e5d42f9b622a28379ddcb855b.png" lead="ライセンス取得後、当店ではバリエーション豊富なダイビングツアーをご用意しております。30か所を超える伊豆半島のダイビングスポット全てのツアーが開催可能です。" />

  <section class="section bg-paper">
    <div class="wrap">
      <div class="quick">
        <a href="/tours/price/" class="q reveal"><span class="eyebrow">DAY TOUR</span><strong>日帰りツアー料金</strong><span class="q-sub">三保 ¥{cheapest.price}〜 / 伊豆全ポイント</span></a>
        <a href="/tours/rental/" class="q reveal" data-delay="1"><span class="eyebrow">RENTAL</span><strong>レンタル器材料金</strong><span class="q-sub">1日レンタル・年間パスポート</span></a>
        <a href="/tours/points/" class="q reveal" data-delay="2"><span class="eyebrow">POINTS</span><strong>ダイビングポイント</strong><span class="q-sub">西伊豆・東伊豆・南伊豆・千葉…</span></a>
        <a href="/blog/" class="q reveal" data-delay="3"><span class="eyebrow">EXPEDITION</span><strong>1泊2日＆遠征ツアー</strong><span class="q-sub">沖縄・海外・伊豆諸島・九州・四国</span></a>
      </div>
      <div class="grid-2 mt-4">
        <div class="reveal">
          <p class="eyebrow">OUR TOUR</p>
          <h2 class="h2">当店のツアーはここが違う！！</h2>
          <p class="lead">日帰りで行ける伊豆半島ツアーを始め、沖縄・海外・伊豆諸島・千葉・九州・四国などの泊りツアーも開催しています。お一人様でのご参加も大歓迎です。水中はもちろん、車中・休憩中・食事など全ての時間を楽しく過ごして頂く事が私たちのモットーです。</p>
        </div>
        <ul class="check-list reveal" data-delay="1">{TOUR_FEATURES.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section-tight gallery">
    <div class="marquee" aria-hidden="true">
      <div class="track">{[...TOUR_GALLERY, ...TOUR_GALLERY].map((src) => <img src={src} alt="" loading="lazy" width="320" height="240" />)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead en="Day Tour Schedule" ja="日帰りツアースケジュール" center lead="毎日開催。カレンダーの予定に無い日もリクエストOKです。" />
      <div class="cal reveal"><iframe src={SITE.calendar} title="ツアースケジュール" loading="lazy"></iframe></div>
      <div class="center mt-2"><a href="/tours/price/" class="btn">日帰りツアー料金表を見る</a></div>
    </div>
  </section>

  <section class="section bg-foam">
    <div class="wrap">
      <SectionHead en="Areas" ja="エリアから探す" />
      <div class="areas">
        {AREA_CATEGORIES.map((a, i) => <a href={`/category/${a.slug}/`} class="area reveal" data-delay={i % 4}><span class="display">{a.slug.replace('-area', '').replace('-areas', '').toUpperCase()}</span><span>{a.name}</span></a>)}
      </div>
      {expedition.length > 0 && (
        <div class="mt-4">
          <p class="eyebrow">EXPEDITION LOG</p>
          <ul class="exp-list">{expedition.map((p) => <li><a href={p.path}>{p.title}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <CtaBand title="ツアーのご予約・リクエスト" body="行きたいポイント、見たい生物、お気軽にリクエストください。伊豆方面は2名様から、三保は1名様から開催します。" />
</Base>

<style>
  .quick { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .q { background: #fff; border-radius: var(--r); padding: 1.4rem 1.5rem; display: grid; gap: 0.2rem; color: var(--ink); text-decoration: none !important; border: 1px solid var(--line); transition: transform 0.4s var(--ease), border-color 0.3s; }
  .q:hover { transform: translateY(-4px); border-color: var(--navy); }
  .q strong { font-size: 1.15rem; }
  .q-sub { font-size: 0.8rem; color: var(--ink-2); }
  @media (max-width: 900px) { .quick { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .quick { grid-template-columns: 1fr; } }
  .grid-2 { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
  .h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0.3rem 0 0.8rem; }
  @media (max-width: 800px) { .grid-2 { grid-template-columns: 1fr; } }
  .gallery { background: var(--navy); padding: 1.5rem 0; overflow: hidden; }
  .marquee { overflow: hidden; }
  .track { display: flex; gap: 0.8rem; width: max-content; animation: scroll 80s linear infinite; }
  .track img { width: 240px; height: 180px; object-fit: cover; border-radius: 8px; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; } }
  .cal { border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow); background: #fff; }
  .cal iframe { width: 100%; height: 600px; border: 0; display: block; }
  .areas { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
  .area { background: #fff; border-radius: var(--r); padding: 1.4rem 1rem; text-align: center; display: grid; gap: 0.2rem; color: var(--ink); text-decoration: none !important; box-shadow: 0 10px 30px -18px rgba(10,26,51,0.3); transition: transform 0.4s var(--ease); }
  .area:hover { transform: translateY(-4px); }
  .area .display { font-size: 1.6rem; color: var(--ocean); }
  @media (max-width: 800px) { .areas { grid-template-columns: repeat(2, 1fr); } }
  .exp-list { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.4rem; }
</style>

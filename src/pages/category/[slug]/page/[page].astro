---
import BlogList from '../../../../layouts/BlogList.astro';
import { loadAll, paginate } from '../../../../lib/posts';
export async function getStaticPaths() {
  const { posts, categories } = await loadAll();
  return categories.flatMap((c) => {
    const pages = paginate(posts.filter((p) => p.category?.slug === c.slug), 24);
    return pages.slice(1).map((items, i) => ({ params: { slug: c.slug, page: String(i + 2) }, props: { items, total: pages.length, current: i + 2, category: c } }));
  });
}
const { items, total, current, category } = Astro.props;
---
<BlogList posts={items} current={current} total={total} base={`/category/${category.slug}/`} category={category} />

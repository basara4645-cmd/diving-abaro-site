---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { RENTAL, RENTAL_NOTES } from '../../../data/tours';
---
<Base title="レンタル器材料金" description="ダイビング器材のレンタル料金表。1日レンタルと年間パスポート。フルレンタルはウエット8,470円・ドライ9,460円。">
  <PageHero en="Rental Equipment" ja="レンタル器材料金" crumbs={[{ href: '/tours/', label: 'ツアー＆料金' }]} image="/wp-content/uploads/2023/11/102620e92521987c0b157fbd45b5c816.jpg" lead="器材をお持ちでなくても大丈夫。1日レンタルのほか、年間パスポートでお得にご利用いただけます。" />
  <section class="section bg-paper">
    <div class="wrap">
      <div class="table-wrap reveal">
        <table class="tbl">
          <thead><tr><th>レンタル器材名</th><th>1日レンタル料金</th><th>レンタル年間パスポート料金</th></tr></thead>
          <tbody>{RENTAL.map(([n, d, y]) => <tr><td><strong>{n}</strong></td><td class="num">{d === '-' ? '—' : `¥${d}`}</td><td class="num">{y === '-' ? <span class="muted">—</span> : `¥${y}`}</td></tr>)}</tbody>
        </table>
      </div>
      <ul class="note-list mt-2">{RENTAL_NOTES.map((n) => <li>{n}</li>)}</ul>
      <p class="mt-2"><a href="/tours/price/" class="btn btn-ghost">日帰りツアー料金を見る</a></p>
    </div>
  </section>
  <CtaBand />
</Base>

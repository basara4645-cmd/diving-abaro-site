---
import Breadcrumb from './Breadcrumb.astro';
const { en, ja, image, crumbs = [], lead } = Astro.props;
---
<section class="ph">
  {image && <img src={image} alt="" class="bg" width="1600" height="900" fetchpriority="high" />}
  <div class="veil"></div>
  <div class="wrap inner">
    <Breadcrumb items={[...crumbs, { label: ja }]} />
    <h1 class="display">{en}</h1>
    <p class="title-ja">{ja}</p>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
<style>
  .ph { position: relative; background: var(--navy); color: #fff; padding: clamp(5rem, 10vw, 8rem) 0 clamp(3rem, 6vw, 5rem); overflow: hidden; min-height: 360px; display: flex; align-items: flex-end; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
  .veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,26,51,0.35) 0%, rgba(10,26,51,0.75) 100%); }
  .inner { position: relative; }
  .display { font-size: clamp(2.6rem, 8vw, 5.5rem); margin-top: 1rem; }
  .title-ja { color: #d7e3f7; }
  .lead { color: #d7e3f7; margin-top: 1rem; }
  :global(.bc) { color: #b9cbe8; }
  :global(.bc span) { color: #fff; }
</style>

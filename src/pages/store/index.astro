---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../lib/site';
const UP = '/wp-content/uploads';
const staff = [
  { name: '大庭 広誉', role: '代表 / PADIインストラクター', img: `${UP}/2023/02/prof-ohba.png`, sub: `${UP}/2023/07/36b8ca80f63ce65ab3b98326e028e143.png`, body: '成田空港で英語を話し掛けられる確率は70%だが生まれも育ちもJAPAN!! ブログを真剣に作ってる時には話し掛け辛いオーラを放っているが、それ以外は温厚な性格。とにかくダイビングが好きでタンクを背負い水中に入ると生き生きしている。ダイビングショップアバロの代表として日々、お客様へのより良いダイビング、サービスを追求している。' },
  { name: 'ニーナ', role: 'ダイブマスター', img: `${UP}/2023/02/prof-nina.png`, sub: `${UP}/2023/07/11650cfec97b1fc66a650bd0977a454e.png`, body: '海外ダイビングから日本のダイビングに興味を持ち、ダイブマスターとして日々奮闘中。口癖は【いささか】と【変な話】、1日10回はこの言葉を使う。独特な笑い声と明るさから彼女の周りには常に人がいます。ニーナワールドにハマるお客様続出！！根っからのダイビングオタクです。' },
  { name: '佐々木 晟名', role: 'PADIインストラクター', img: `${UP}/2023/07/Unknown-e1689241267625.jpeg`, sub: `${UP}/2023/07/11650cfec97b1fc66a650bd0977a454e-1.png`, body: '学生時代ダイビングサークルに所属し在学中にインストラクターを取得するという最短コース。若さと元気。そして持ち前の【忍耐力】と【気遣い】が出来るアバロ期待の星。' },
];
const company = [
  ['店名', 'ダイビングショップ アバロ'], ['住所', SITE.address], ['TEL / FAX', SITE.tel], ['設立', '令和2年1月1日'], ['営業時間', SITE.hours], ['定休日', SITE.holiday],
  ['代表者', '大庭 広誉'], ['駐車場', '有　10台'], ['指導団体', 'PADI'], ['事業内容', 'ダイビングスクール、ダイビングツアー、ダイビング、器材販売、応急救護講習、水中作業、水中撮影'],
];
---
<Base title="店舗情報" description="ダイビングショップ アバロの店舗情報。静岡市清水区上原2-5-8、営業時間11:00〜20:00、定休日火曜日、駐車場10台。スタッフ紹介・会社概要・アクセス。">
  <PageHero en="Store" ja="店舗情報" image="/wp-content/uploads/2023/11/b90ea76be3a4162ae61b3bb6325eaf55.jpg" />
  <section class="section bg-paper">
    <div class="wrap-narrow greeting reveal">
      <p class="eyebrow">GREETING</p>
      <h2 class="g-title">ほんの少しの勇気を持って1歩を踏み込むだけ。<br />あとは私たちにお任せください。</h2>
      <p>ダイビングの魅力に気付き、早20年が過ぎようとしています。陸上には無い自然が作り出す景色、様々な水中生物の生態、無音の中に響き渡る自分が吐き出す泡の音、海中に差し込む幻想的な太陽の光。こんな魅力を1人でも多くの方にお伝えしたいです。</p>
      <p>お一人様のご参加も大歓迎です。特殊な環境の中で楽しむスポーツです。最初は1人でもスクールやツアーにご参加頂く度に仲間が増えていきます。</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <SectionHead en="Staff" ja="スタッフ紹介" />
      <div class="staff">
        {staff.map((s, i) => (
          <article class="member reveal" data-delay={i}>
            <div class="m-img"><img src={s.img} alt={s.name} loading="lazy" width="400" height="400" /></div>
            <div class="m-body">
              <span class="eyebrow">{s.role}</span>
              <h3>{s.name}</h3>
              <p>{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section bg-navy grain">
    <div class="wrap grid-2">
      <div>
        <SectionHead en="Company" ja="会社概要" />
        <dl class="company reveal">{company.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="map reveal" data-delay="1">
        <iframe src={SITE.map} title="地図" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p class="access">JR清水駅・草薙駅、静鉄 清水駅・草薙駅・御門台駅・狐ヶ崎駅、JR沼津駅・三島駅から無料送迎あり。ショップ横に駐車場10台以上完備。</p>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .g-title { font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 2rem); margin: 0.4rem 0 1.2rem; color: var(--navy); line-height: 1.6; }
  .staff { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .member { background: #fff; border-radius: var(--r); overflow: hidden; box-shadow: 0 10px 30px -18px rgba(10,26,51,0.35); }
  .m-img { aspect-ratio: 1; overflow: hidden; }
  .m-img img { width: 100%; height: 100%; object-fit: cover; }
  .m-body { padding: 1.4rem 1.5rem 1.6rem; }
  .m-body h3 { font-size: 1.4rem; margin: 0.1rem 0 0.6rem; }
  .m-body p { font-size: 0.9rem; color: var(--ink-2); margin: 0; }
  @media (max-width: 900px) { .staff { grid-template-columns: 1fr; } .member { display: grid; grid-template-columns: 200px 1fr; } }
  @media (max-width: 560px) { .member { grid-template-columns: 1fr; } }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .company { margin: 0; }
  .company div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid rgba(255,255,255,0.12); font-size: 0.95rem; }
  .company dt { color: var(--aqua); font-weight: 700; }
  .company dd { margin: 0; color: #eaf1ff; }
  .map iframe { width: 100%; height: 420px; border: 0; border-radius: var(--r); }
  .access { font-size: 0.85rem; color: #b9cbe8; margin-top: 1rem; }
  @media (max-width: 800px) { .grid-2 { grid-template-columns: 1fr; } }
</style>

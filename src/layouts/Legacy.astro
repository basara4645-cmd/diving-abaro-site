---
/**
 * 旧WordPress（OceanWP + Elementor）の見た目をそのまま再現するレイアウト。
 * CSS・JS・ヘッダー・フッターは旧サイトの出力をそのまま使う。
 */
import { SITE } from '../lib/site';
import inlineConfig from '../data/legacy/inline-config.js?raw';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
  jsonLd?: Record<string, unknown>;
  /** ページごとのヘッダー/フッターHTML（旧サイトはページ別にヘッダーが異なる） */
  headerHtml: string;
  /** name="footer" スロットを渡した場合は不要（英語ページは独自フッターを使う） */
  footerHtml?: string;
  /** そのページが旧サイトで読み込んでいたCSSの一覧（順序も同じ） */
  cssList: string[];
  /** trueなら<title>に日本語の店名を付け足さない（英語ページ用） */
  rawTitle?: boolean;
  /** 英語ページ用: 対応する日本語ページのURL（言語切り替えボタンに使う） */
  jaPath?: string;
}
const {
  title,
  description = SITE.description,
  image = '/wp-content/uploads/2023/02/main02.png',
  bodyClass = '',
  jsonLd,
  headerHtml,
  footerHtml,
  cssList,
  rawTitle = false,
  jaPath,
} = Astro.props;

const isEn = bodyClass.includes('en');

/** 日本語ページ → 対応する英語ページ（hreflangと切り替えボタンに使う） */
const EN_ALTERNATE: Record<string, string> = {
  '/': '/en/',
  '/各種ライセンスコース/': '/en/courses/',
  '/one-day-tour-日帰りツアー料金/': '/en/prices/',
  '/rentel-equipment-materials-レンタル器材料金/': '/en/prices/',
  '/store/': '/en/access/',
  '/contact/': '/en/booking/',
};
const enPath = EN_ALTERNATE[decodeURIComponent(Astro.url.pathname)] ?? '/en/';

/** 言語切り替えボタン2つ分のリンク先 */
const jaHref = isEn ? (jaPath ?? '/') : Astro.url.pathname;
const enHref = isEn ? Astro.url.pathname : enPath;

/**
 * スマホでは右上のボタンがハンバーガーメニューと重なるため、
 * メニューを開いたときの一番上に言語切り替えを差し込む。
 */
const langMenuItems =
  `<li class="menu-item lang-menu-item">` +
  `<a href="${jaHref}" hreflang="ja" class="elementor-item${!isEn ? ' lang-menu-item--current' : ''}">` +
  `<span class="lang-menu-item__flag">🇯🇵</span>日本語</a></li>` +
  `<li class="menu-item lang-menu-item">` +
  `<a href="${enHref}" hreflang="en" class="elementor-item${isEn ? ' lang-menu-item--current' : ''}">` +
  `<span class="lang-menu-item__flag">🇺🇸</span>English</a></li>`;

const dropdownUl = /(<nav class="elementor-nav-menu--dropdown[^"]*"[^>]*>\s*<ul[^>]*>)/;
const hasDropdown = dropdownUl.test(headerHtml);
const headerWithLang = hasDropdown
  ? headerHtml.replace(dropdownUl, `$1${langMenuItems}`)
  : headerHtml;

const fullTitle = rawTitle
  ? (title ?? SITE.name)
  : title
    ? `${title}｜${SITE.name}`
    : '静岡市清水区のダイビングショップ「アバロ」公式HP';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// 旧サイトが読み込んでいたJS（順序も同じ）
const JS = [
  '/wp-includes/js/jquery/jquery.min.js',
  '/wp-includes/js/jquery/jquery-migrate.min.js',
  '/wp-content/plugins/ele-custom-skin/assets/js/ecs.js',
  '/wp-content/plugins/ele-custom-skin/assets/js/ecs_ajax_pagination.js',
  '/wp-content/themes/oceanwp/assets/js/vendors/magnific-popup.min.js',
  '/wp-content/themes/oceanwp/assets/js/vendors/flickity.pkgd.min.js',
  '/wp-content/themes/oceanwp/assets/js/drop-down-mobile-menu.min.js',
  '/wp-content/themes/oceanwp/assets/js/drop-down-search.min.js',
  '/wp-content/themes/oceanwp/assets/js/ow-lightbox.min.js',
  '/wp-content/themes/oceanwp/assets/js/ow-slider.min.js',
  '/wp-content/themes/oceanwp/assets/js/scroll-effect.min.js',
  '/wp-content/themes/oceanwp/assets/js/scroll-top.min.js',
  '/wp-content/themes/oceanwp/assets/js/select.min.js',
  '/wp-content/themes/oceanwp/assets/js/theme.min.js',
  '/wp-includes/js/imagesloaded.min.js',
  '/wp-content/plugins/essential-addons-for-elementor-lite/assets/front-end/js/view/general.min.js',
  '/wp-content/plugins/elementor/assets/js/webpack.runtime.min.js',
  '/wp-content/plugins/elementor/assets/js/frontend-modules.min.js',
  '/wp-content/plugins/elementor/assets/lib/waypoints/waypoints.min.js',
  '/wp-includes/js/jquery/ui/core.min.js',
  '/wp-content/plugins/elementor/assets/js/frontend.min.js',
  '/wp-content/plugins/elementor-pro/assets/lib/smartmenus/jquery.smartmenus.min.js',
  '/wp-content/plugins/elementor-pro/assets/js/webpack-pro.runtime.min.js',
  '/wp-includes/js/dist/hooks.min.js',
  '/wp-includes/js/dist/i18n.min.js',
  '/wp-content/plugins/elementor-pro/assets/js/frontend.min.js',
  '/wp-content/plugins/elementor-pro/assets/js/elements-handlers.min.js',
];

/**
 * CSS・JSはファイル名が変わらないため、中身を直してもブラウザが古いものを
 * 使い続けることがある。URLの末尾にバージョンを付けて確実に読み直させる。
 * 旧テーマのCSSを修正したら、この値を上げること。
 */
const ASSET_VER = '2';
const v = (href: string) => `${href}?v=${ASSET_VER}`;

const bodyClasses = [
  'wp-singular page-template-default page wp-theme-oceanwp',
  'oceanwp-theme dropdown-mobile no-header-border default-breakpoint content-full-width',
  'has-breadcrumbs elementor-default elementor-kit-5',
  bodyClass,
].join(' ');
---

<!doctype html>
<html lang={isEn ? "en" : "ja"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'ja_JP'} />
    <meta property="og:locale:alternate" content={isEn ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!isEn && EN_ALTERNATE[decodeURIComponent(Astro.url.pathname)] && (
      <>
        <link rel="alternate" hreflang="ja" href={canonical} />
        <link rel="alternate" hreflang="en" href={new URL(enPath, SITE.url).href} />
        <link rel="alternate" hreflang="x-default" href={canonical} />
      </>
    )}
    {isEn && jaPath && (
      <>
        <link rel="alternate" hreflang="en" href={canonical} />
        <link rel="alternate" hreflang="ja" href={new URL(jaPath, SITE.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(jaPath, SITE.url).href} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Roboto:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic%7CRoboto+Slab:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic%7COswald:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic%7CNoto+Sans+JP:100,100italic,200,200italic,300,300italic,400,400italic,500,500italic,600,600italic,700,700italic,800,800italic,900,900italic&display=swap"
    />
    {cssList.map((href) => <link rel="stylesheet" href={v(href)} />)}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class={bodyClasses}>
    <div id="outer-wrap" class="site clr">
      <div id="wrap" class="clr">
        <Fragment set:html={headerWithLang} />
        <div class={`lang-switch-group ${hasDropdown ? 'has-menu-lang' : ''}`}>
          <a
            class={`lang-switch ${!isEn ? 'is-current' : ''}`}
            href={jaHref}
            hreflang="ja"
            aria-current={!isEn ? 'true' : undefined}
          >
            <span class="lang-switch__flag">🇯🇵</span>日本語
          </a>
          <a
            class={`lang-switch ${isEn ? 'is-current' : ''}`}
            href={enHref}
            hreflang="en"
            aria-current={isEn ? 'true' : undefined}
          >
            <span class="lang-switch__flag">🇺🇸</span>English
          </a>
        </div>
        <main id="main" class="site-main clr">
          <slot />
        </main>
        {Astro.slots.has('footer')
          ? <slot name="footer" />
          : <Fragment set:html={footerHtml} />}
      </div>
    </div>
    <script is:inline set:html={inlineConfig} />
    {JS.map((src) => <script is:inline src={v(src)}></script>)}
  </body>
</html>

<style is:global>
  /* 日本語⇔英語の切り替えボタン（旧サイトのメニューには無いので後から足している） */
  .lang-switch-group {
    position: fixed; top: 12px; right: 12px; z-index: 9999;
    display: flex; gap: 6px;
  }
  .lang-switch {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(20, 30, 40, .55); color: #fff !important;
    font-size: 12px; letter-spacing: .04em; line-height: 1;
    padding: 8px 12px; border-radius: 999px; text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .25);
    transition: background .15s;
  }
  .lang-switch:hover { background: rgba(20, 30, 40, .8); }
  .lang-switch.is-current {
    background: rgba(11, 92, 138, .95);
    pointer-events: none;
  }
  .lang-switch__flag { font-size: 14px; line-height: 1; }

  /* ハンバーガーメニュー内の言語切り替え（スマホ専用）。
     旧テーマの .elementor-nav-menu li より詳細度を上げないと打ち消されてしまう */
  .elementor-nav-menu li.lang-menu-item { display: none; }
  .lang-menu-item > .elementor-item {
    display: flex !important; align-items: center; gap: 8px;
    font-weight: 700;
  }
  .lang-menu-item--current { background: rgba(11, 92, 138, .12); }
  .lang-menu-item__flag { font-size: 17px; line-height: 1; }

  @media (max-width: 767px) {
    .lang-switch-group { top: 8px; right: 8px; gap: 4px; }
    .lang-switch { padding: 7px 10px; font-size: 11px; }
    /* メニューの中に入れたので、右上のボタンはハンバーガーと重ならないよう隠す */
    .lang-switch-group.has-menu-lang { display: none; }
    .elementor-nav-menu li.lang-menu-item { display: block; }
  }
</style>
